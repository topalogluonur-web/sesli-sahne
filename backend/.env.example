PORT=5055
HOST=0.0.0.0
DATABASE_PATH=./data/sesli-sahne.sqlite
UPLOAD_ROOT=./uploads

# Önerilen keysiz Türkçe ses modu: Python edge-tts.
# API key gerekmez, internet gerekir. İlk kurulum için ana klasörde INSTALL_EDGE_TTS_PYTHON.bat çalıştır.
TTS_PROVIDER=edge_python
EDGE_TTS_VOICE_NAME=
EDGE_TTS_RATE=-16%
EDGE_TTS_PAUSE_LEVEL=normal
EDGE_TTS_MAX_CHARS=2300

# Alternatifler:
# TTS_PROVIDER=edge_online       (eski WebSocket yöntemi)
# TTS_PROVIDER=local_windows     (Windows SAPI, Türkçe ses yoksa aksanlı okuyabilir)
# TTS_PROVIDER=openai            (API key gerekir)

LOCAL_TTS_CULTURE=tr-TR
LOCAL_TTS_VOICE_NAME=
LOCAL_TTS_RATE=0

OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

NODE_ENV=development

# v27 Admin/Yayıncı paneli girişi
ADMIN_AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=0000
ADMIN_JWT_SECRET=local-dev-secret-change-me
ADMIN_TOKEN_TTL_HOURS=12
